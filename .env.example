# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=replace-me

# Opcional: guild de desarrollo para sincronizar slash commands inmediatamente.
# Si queda vacío, los comandos se sincronizan globalmente.
DEV_GUILD_ID=

# Persistencia local de configuración y recordatorios.
DATABASE_PATH=data/pybot.db

# INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO

# true para sincronizar comandos al iniciar.
SYNC_COMMANDS=true

# No es necesario para los slash commands actuales.
# Activarlo exige habilitar Message Content Intent en Discord Developer Portal.
ENABLE_MESSAGE_CONTENT_INTENT=false

BOT_STATUS=Usá /ayuda
CURRENCY_API_BASE_URL=https://dolarapi.com/v1
HTTP_TIMEOUT_SECONDS=8
